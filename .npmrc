# Bun runtime imports many nested packages by absolute path from repo root.
# Hoist dependencies so `bun run src/server` resolves the same as historical bun installs.
shamefully-hoist=true
public-hoist-pattern[]=*
node-linker=hoisted

# Vite/esbuild need postinstall binaries on pure-web SPA builds.
dangerouslyAllowAllBuilds=true
